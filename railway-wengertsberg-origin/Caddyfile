:8080 {
	@health path /healthz
	handle @health {
		reverse_proxy {$WORDPRESS_UPSTREAM} {
			rewrite /railway-health.php
			header_up Host wengertsberg.de
			header_up X-Forwarded-Proto https
		}
	}

	@cloudfront header X-Wengertsberg-Origin-Key {$ORIGIN_VERIFY}
	handle @cloudfront {
		reverse_proxy {$WORDPRESS_UPSTREAM} {
			header_up Host wengertsberg.de
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		respond "Forbidden" 403
	}
}
